diff --git a/dm/host/netpad.h b/dm/host/netpad.h
new file mode 100644
index 0000000..2ce4ce1
--- /dev/null
+++ b/dm/host/netpad.h
@@ -0,0 +1,69 @@
+// Network pads (netpad_mac.m; pure, so tests/t_netpad.c checks it without a socket): a phone or another local program drives a pad over UDP on 127.0.0.1, one datagram per message.
+//   P <pad> <buttons> <lx> <ly> <rx> <ry>   the pad's state: <pad> 1..DM_PLAYERS is the sender's own pad number (the host gives it a player the way it gives a controller one, pad_slots.h),
+//                                           <buttons> the DM_BTN_* bits 0..15 (dm_input.h) as a decimal number, the sticks -32767..32767 (clamped), +y up
+//   L <pad>                                 the pad has left (everything released)
+// A pad that sends nothing for NETPAD_TIMEOUT_S has left too, so a sender that dies cannot leave a button held; a sender repeats its P message about once a second while nothing changes.
+// A message is plain ASCII, fields split by spaces, a trailing newline or CR allowed (nc -u sends one). Anything else is ignored whole: no field is guessed.
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "dm_input.h"
+
+#define NETPAD_PORT 47600        // what the launcher's "Phone controllers" setting selects (DM_NETPAD=47600); the host never opens a port on its own
+#define NETPAD_TIMEOUT_S 2.0
+#define NETPAD_MAX_LEN 96        // a longer datagram is not ours
+
+typedef struct { char kind; int pad; uint64_t buttons; int32_t lx, ly, rx, ry; } netpad_msg;   // kind 'P' or 'L'; pad is 0..DM_PLAYERS-1
+
+// One whole decimal number after at least one space: an optional sign, 1..18 digits. Moves *p past it.
+static int netpad_num(const char **p, long long *v) {
+    const char *s = *p;
+    if (*s != ' ') return 0;
+    while (*s == ' ') s++;
+    int neg = 0;
+    if (*s == '-' || *s == '+') neg = *s++ == '-';
+    int n = 0; long long x = 0;
+    for (; *s >= '0' && *s <= '9'; s++, n++) { if (n >= 18) return 0; x = x * 10 + (*s - '0'); }
+    if (!n) return 0;
+    *p = s; *v = neg ? -x : x;
+    return 1;
+}
+static int32_t netpad_stick(long long v) { return v > DM_STICK_MAX ? DM_STICK_MAX : v < -DM_STICK_MAX ? -DM_STICK_MAX : (int32_t)v; }
+// Parses one datagram (not NUL-terminated, n bytes) into *out. Returns 1 for a message that is whole and valid, else 0 and *out is not to be used.
+static int netpad_parse(const char *data, size_t n, netpad_msg *out) {
+    if (!data || n < 3 || n > NETPAD_MAX_LEN || memchr(data, 0, n)) return 0;
+    char b[NETPAD_MAX_LEN + 1]; memcpy(b, data, n); b[n] = 0;
+    while (n && (b[n - 1] == '\n' || b[n - 1] == '\r' || b[n - 1] == ' ')) b[--n] = 0;
+    if ((b[0] != 'P' && b[0] != 'L') || b[1] != ' ') return 0;
+    const char *p = b + 1; long long v[6]; int want = b[0] == 'P' ? 6 : 1;
+    for (int i = 0; i < want; i++) if (!netpad_num(&p, &v[i])) return 0;
+    if (*p || v[0] < 1 || v[0] > DM_PLAYERS) return 0;
+    if (want == 6 && v[1] < 0) return 0;
+    *out = (netpad_msg){.kind = b[0], .pad = (int)v[0] - 1};
+    if (want == 6) {
+        out->buttons = (uint64_t)v[1] & 0xffffull;   // bits 0..15 only: the rail buttons and Shake are not a phone's to press
+        out->lx = netpad_stick(v[2]); out->ly = netpad_stick(v[3]); out->rx = netpad_stick(v[4]); out->ry = netpad_stick(v[5]);
+    }
+    return 1;
+}
+
+// Which pads are live and when each last sent. The caller gives every time (seconds on any steady clock), so tests need no clock.
+typedef struct { uint32_t live; double seen[DM_PLAYERS]; } netpad_state;
+
+static int netpad_touch(netpad_state *s, int pad, double now) {   // a message from pad: 1 when it was not live before
+    int fresh = !(s->live >> pad & 1);
+    s->live |= 1u << pad; s->seen[pad] = now;
+    return fresh;
+}
+static int netpad_leave(netpad_state *s, int pad) {   // 1 when the pad was live
+    int was = s->live >> pad & 1;
+    s->live &= ~(1u << pad);
+    return was;
+}
+static uint32_t netpad_expire(netpad_state *s, double now, double timeout) {   // pads silent for more than timeout, now not live: a mask
+    uint32_t gone = 0;
+    for (int p = 0; p < DM_PLAYERS; p++) if ((s->live >> p & 1) && now - s->seen[p] > timeout) gone |= 1u << p;
+    s->live &= ~gone;
+    return gone;
+}
diff --git a/dm/host/netpad_mac.m b/dm/host/netpad_mac.m
new file mode 100644
index 0000000..55b5fd0
--- /dev/null
+++ b/dm/host/netpad_mac.m
@@ -0,0 +1,54 @@
+// Network pads on the Mac host (netpad.h has the messages): DM_NETPAD=<port> listens on 127.0.0.1:<port> for UDP datagrams from a phone's controller page or any local program, and each pad
+// that sends becomes a player of its own like a physical controller (controllers_mac.m: the same slots, merge mode, press-to-join and focus rules). Off unless DM_NETPAD names a port:
+// any process on this Mac can send to a loopback port, so the player turns it on (the launcher's "Phone controllers" setting sets DM_NETPAD=47600). Everything runs on the main queue.
+#import <Foundation/Foundation.h>
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+#include "controllers_mac.h"
+#include "netpad.h"
+
+static dispatch_source_t g_netpad_read, g_netpad_timer;   // kept in statics: a dispatch source that ARC releases is cancelled
+static netpad_state g_netpad;
+
+static double netpad_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (double)t.tv_sec + t.tv_nsec / 1e9; }
+static void netpad_packet(const char *data, size_t n, double now) {
+    netpad_msg m;
+    if (!netpad_parse(data, n, &m)) return;
+    if (m.kind == 'L') { if (netpad_leave(&g_netpad, m.pad)) controllers_netpad_leave(m.pad); return; }
+    netpad_touch(&g_netpad, m.pad, now);
+    controllers_netpad_set(m.pad, m.buttons, m.lx, m.ly, m.rx, m.ry);
+}
+static void netpad_expire_at(double now) {   // a pad whose sender went quiet leaves, so a crashed sender cannot hold a button
+    uint32_t gone = netpad_expire(&g_netpad, now, NETPAD_TIMEOUT_S);
+    for (int p = 0; p < DM_PLAYERS; p++) if (gone >> p & 1) controllers_netpad_leave(p);
+}
+
+void netpad_start(void) {
+    const char *e = getenv("DM_NETPAD");
+    if (!e || !*e || !strcmp(e, "0")) return;
+    char *end; long port = strtol(e, &end, 10);
+    if (*end || port < 1 || port > 65535) { fprintf(stderr, "netpad: DM_NETPAD=%s is not a port (1..65535), network pads are off\n", e); return; }
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) { fprintf(stderr, "netpad: socket: %s\n", strerror(errno)); return; }
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons((uint16_t)port), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    if (bind(fd, (struct sockaddr *)&a, sizeof a) < 0) { fprintf(stderr, "netpad: cannot bind 127.0.0.1:%ld (%s), network pads are off\n", port, strerror(errno)); close(fd); return; }
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    g_netpad_read = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)fd, 0, dispatch_get_main_queue());
+    dispatch_source_set_event_handler(g_netpad_read, ^{
+        char buf[NETPAD_MAX_LEN + 1]; ssize_t n;   // one byte more than a message can be, so a longer datagram is seen as such
+        while ((n = recv(fd, buf, sizeof buf, 0)) >= 0) netpad_packet(buf, (size_t)n, netpad_now());
+    });
+    dispatch_source_set_cancel_handler(g_netpad_read, ^{ close(fd); });
+    dispatch_resume(g_netpad_read);
+    g_netpad_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(g_netpad_timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 2), NSEC_PER_SEC / 2, NSEC_PER_SEC / 10);
+    dispatch_source_set_event_handler(g_netpad_timer, ^{ netpad_expire_at(netpad_now()); });
+    dispatch_resume(g_netpad_timer);
+    fprintf(stderr, "netpad: network pads listen on 127.0.0.1:%ld (DM_NETPAD)\n", port);
+}
