diff --git a/dm/host/tests/t_netpad.c b/dm/host/tests/t_netpad.c
new file mode 100644
index 0000000..104a08e
--- /dev/null
+++ b/dm/host/tests/t_netpad.c
@@ -0,0 +1,59 @@
+// Network pads (netpad.h): the messages a phone sends, what is ignored whole, and which pads are live as a function of an explicit time
+#include <stdio.h>
+#include "../netpad.h"
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+static int parse(const char *s, netpad_msg *m) { return netpad_parse(s, strlen(s), m); }
+
+int main(void) {
+    netpad_msg m;
+    CHECK(parse("P 1 0 0 0 0 0", &m) && m.kind == 'P' && m.pad == 0 && !m.buttons && !m.lx && !m.ry, "an idle pad 1");
+    CHECK(parse("P 8 65535 32767 -32767 1 -1", &m) && m.pad == 7 && m.buttons == 0xffff && m.lx == 32767 && m.ly == -32767 && m.rx == 1 && m.ry == -1, "pad 8, every button, the sticks as sent");
+    CHECK(parse("P 3 1 0 0 0 0\n", &m) && m.pad == 2 && m.buttons == 1, "nc -u's newline is fine");
+    CHECK(parse("P 3 1 0 0 0 0\r\n", &m) && parse("P  2   5  1  2  3  4 ", &m) && m.pad == 1 && m.buttons == 5 && m.ry == 4, "CR LF and repeated spaces are fine");
+    CHECK(parse("P 2 +4 +7 0 0 0", &m) && m.buttons == 4 && m.lx == 7, "a plus sign is fine");
+    CHECK(parse("L 4", &m) && m.kind == 'L' && m.pad == 3, "a pad leaves");
+    CHECK(parse("L 4\n", &m) && m.pad == 3, "a leave with a newline");
+
+    // clamping and masking
+    CHECK(parse("P 1 0 99999 -99999 40000 -40000", &m) && m.lx == DM_STICK_MAX && m.ly == -DM_STICK_MAX && m.rx == DM_STICK_MAX && m.ry == -DM_STICK_MAX, "sticks clamp to +-32767");
+    CHECK(parse("P 1 -0 0 0 0 0", &m) && !m.buttons, "-0 is zero");
+    CHECK(parse("P 1 4294967295 0 0 0 0", &m) && m.buttons == 0xffff, "buttons above bit 15 are dropped");
+    CHECK(parse("P 1 16777216 0 0 0 0", &m) && m.buttons == 0, "the rail buttons (bit 24) are dropped");
+    CHECK(parse("P 1 9223372036854775808 0 0 0 0", &m) == 0 || m.buttons <= 0xffff, "a 19 digit number is refused or masked, never wraps into a stick");
+    CHECK(!parse("P 1 0 0 0 0 9999999999999999999", &m), "a 19 digit stick is refused");
+    CHECK(parse("P 1 0 999999999999999999 0 0 0", &m) && m.lx == DM_STICK_MAX, "an 18 digit stick clamps");
+
+    // ignored whole
+    const char *bad[] = {"", "P", "P ", "P 1", "P 1 0 0 0 0", "P 1 0 0 0 0 0 0", "P 1 0 0 0 0 0 x", "P 0 0 0 0 0 0", "P 9 0 0 0 0 0", "P -1 0 0 0 0 0", "P 1 -1 0 0 0 0",
+                         "P1 0 0 0 0 0", "p 1 0 0 0 0 0", "Q 1 0 0 0 0 0", "L", "L ", "L 0", "L 9", "L 1 1", "L x", "L 1x", "P 1 0x10 0 0 0 0", "P 1 1.5 0 0 0 0", "P 1 0 0 0 0 0,",
+                         "P 1 0 0 0 0 --1", "P 1 0 0 0 0 +", " P 1 0 0 0 0 0", "P\t1 0 0 0 0 0", "P 1 0 0 0 0 0\n0", "P 1 0 0 0 0 0 junk", "P 1e0 0 0 0 0 0", "PL 1"};
+    for (size_t i = 0; i < sizeof bad / sizeof *bad; i++) { char msg[96]; snprintf(msg, sizeof msg, "ignored: \"%s\"", bad[i]); CHECK(!parse(bad[i], &m), msg); }
+    CHECK(!netpad_parse("P 1 0 0 0 0 0\0", 14, &m), "an embedded NUL is refused");
+    CHECK(!netpad_parse(NULL, 5, &m), "no data is refused");
+    CHECK(!netpad_parse("P 1 0 0 0 0 0", 2, &m), "a truncated datagram (only \"P \") is refused");
+    char big[NETPAD_MAX_LEN + 8]; memset(big, ' ', sizeof big); memcpy(big, "P 1 0 0 0 0 0", 13);
+    CHECK(netpad_parse(big, NETPAD_MAX_LEN, &m) && !netpad_parse(big, NETPAD_MAX_LEN + 1, &m), "a datagram of NETPAD_MAX_LEN is read, one byte more is not ours");
+    memset(big, '9', sizeof big); memcpy(big, "P 1 ", 4);
+    CHECK(!netpad_parse(big, NETPAD_MAX_LEN, &m), "a very long number is refused");
+    const char unterminated[3] = {'L', ' ', '2'};
+    CHECK(netpad_parse(unterminated, 3, &m) && m.pad == 1, "the data need not be NUL-terminated");
+
+    // who is live
+    netpad_state s; memset(&s, 0, sizeof s);
+    CHECK(netpad_touch(&s, 0, 0.0) == 1 && s.live == 1, "the first message joins (also at time 0)");
+    CHECK(netpad_touch(&s, 0, 0.5) == 0, "a later message of the same pad is no join");
+    CHECK(netpad_touch(&s, 2, 1.0) == 1 && s.live == 5, "another pad joins");
+    CHECK(netpad_expire(&s, 2.5, NETPAD_TIMEOUT_S) == 0, "nothing expires at exactly the timeout of pad 1 (2.5 - 0.5 = 2.0 is not more)");
+    CHECK(netpad_expire(&s, 2.6, NETPAD_TIMEOUT_S) == 1 && s.live == 4, "pad 1 expires just after the timeout, pad 3 stays");
+    CHECK(netpad_expire(&s, 2.7, NETPAD_TIMEOUT_S) == 0, "an expired pad is reported once");
+    CHECK(netpad_touch(&s, 0, 3.0) == 1, "an expired pad that sends again joins again");
+    CHECK(netpad_leave(&s, 0) == 1 && netpad_leave(&s, 0) == 0 && s.live == 4, "a pad leaves once");
+    CHECK(netpad_expire(&s, 100.0, NETPAD_TIMEOUT_S) == 4 && !s.live, "a silent pad expires, whatever the gap");
+    for (int p = 0; p < DM_PLAYERS; p++) netpad_touch(&s, p, 10.0);
+    CHECK(s.live == (1u << DM_PLAYERS) - 1 && netpad_expire(&s, 13.0, NETPAD_TIMEOUT_S) == (1u << DM_PLAYERS) - 1, "all eight pads join and expire together");
+
+    printf("netpad: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_netpad_mac.m b/dm/host/tests/t_netpad_mac.m
new file mode 100644
index 0000000..10fa387
--- /dev/null
+++ b/dm/host/tests/t_netpad_mac.m
@@ -0,0 +1,62 @@
+// Network pads on the Mac host (netpad_mac.m): real datagrams to a loopback port reach the controller hooks, bad ones and a bad DM_NETPAD do not, and a silent pad leaves
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include "../netpad_mac.m"
+
+static int sets, leaves, last_pad = -1; static uint64_t last_buttons; static int32_t last_axes[4];
+void controllers_netpad_set(int pad, uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) { sets++; last_pad = pad; last_buttons = b; last_axes[0] = lx; last_axes[1] = ly; last_axes[2] = rx; last_axes[3] = ry; }
+void controllers_netpad_leave(int pad) { leaves++; last_pad = pad; }
+
+static void send_to(int port, const char *msg) {
+    int fd = socket(AF_INET, SOCK_DGRAM, 0); assert(fd >= 0);
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons((uint16_t)port), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    assert(sendto(fd, msg, strlen(msg), 0, (struct sockaddr *)&a, sizeof a) == (ssize_t)strlen(msg));
+    close(fd);
+}
+static void spin(double s) { [NSRunLoop.mainRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:s]]; }
+
+int main(void) {
+    @autoreleasepool {
+        // off unless DM_NETPAD names a port
+        unsetenv("DM_NETPAD"); netpad_start(); assert(!g_netpad_read);
+        setenv("DM_NETPAD", "0", 1); netpad_start(); assert(!g_netpad_read);
+        setenv("DM_NETPAD", "", 1); netpad_start(); assert(!g_netpad_read);
+        setenv("DM_NETPAD", "47x", 1); netpad_start(); assert(!g_netpad_read);
+        setenv("DM_NETPAD", "70000", 1); netpad_start(); assert(!g_netpad_read);
+        setenv("DM_NETPAD", "-5", 1); netpad_start(); assert(!g_netpad_read);
+
+        int port = 20000 + (int)(getpid() % 20000);
+        char env[16]; snprintf(env, sizeof env, "%d", port); setenv("DM_NETPAD", env, 1);
+        netpad_start(); assert(g_netpad_read && g_netpad_timer);
+
+        send_to(port, "P 2 4097 100 -200 300 -400\n"); spin(0.2);
+        assert(sets == 1 && last_pad == 1 && last_buttons == 4097 && last_axes[0] == 100 && last_axes[1] == -200 && last_axes[2] == 300 && last_axes[3] == -400);
+        send_to(port, "P 2 1 99999 0 0 0"); spin(0.2);
+        assert(sets == 2 && last_axes[0] == DM_STICK_MAX);
+        send_to(port, "garbage"); send_to(port, "P 9 0 0 0 0 0"); send_to(port, "P 1 0 0 0 0"); send_to(port, ""); spin(0.2);
+        assert(sets == 2 && leaves == 0);
+        char big[200]; memset(big, '1', sizeof big - 1); big[sizeof big - 1] = 0; memcpy(big, "P 1 ", 4);
+        send_to(port, big); spin(0.2);
+        assert(sets == 2);
+        send_to(port, "L 2"); spin(0.2);
+        assert(leaves == 1 && last_pad == 1);
+        send_to(port, "L 2"); spin(0.2);
+        assert(leaves == 1);   // already gone
+
+        // several datagrams in one wake-up are all read, in order
+        send_to(port, "P 3 1 0 0 0 0"); send_to(port, "P 4 2 0 0 0 0"); send_to(port, "P 3 8 0 0 0 0"); spin(0.2);
+        assert(sets == 5 && last_pad == 2 && last_buttons == 8);
+
+        // a second start on a taken port does not open another listener
+        dispatch_source_t first = g_netpad_read; netpad_start();
+        assert(g_netpad_read == first);
+
+        // silence: pads 3 and 4 leave once, and only when more than the timeout has passed since their last message
+        double t = netpad_now();
+        netpad_expire_at(t + 1.0); assert(leaves == 1);
+        netpad_expire_at(t + NETPAD_TIMEOUT_S + 1.0); assert(leaves == 3);
+        netpad_expire_at(t + 100.0); assert(leaves == 3);
+        puts("network pads: datagrams, bad input, DM_NETPAD values and the timeout: OK");
+    }
+    return 0;
+}
