+// Network pads (netpad_mac.m). A pad takes a player the way a controller does (DM_PAD_PRESS_TO_JOIN: at its first button press, the lowest free one), is published through the same
+// path, and with DM_PAD_MERGE=1 is merged into player 1
+static void controller_net_publish(int pad) {
+    if (g_merge) { controller_publish(nil); return; }
+    int slot = pad_slot_of(&g_slots, &g_net_owner[pad]);
+    if (slot < 0) return;
+    front_cp_poll();
+    if (g_focus) controller_publish_player(slot, g_net_in[pad].buttons, g_net_in[pad].lx, g_net_in[pad].ly, g_net_in[pad].rx, g_net_in[pad].ry);
+    else controller_publish_player(slot, 0, 0, 0, 0, 0);
+}
+static void controller_net_publish_all(void) {
+    for (int p = 0; p < DM_PLAYERS; p++) if (g_net_live >> p & 1) controller_net_publish(p);
+}
+void controllers_netpad_set(int pad, uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    if (pad < 0 || pad >= DM_PLAYERS) return;
+    g_net_in[pad].buttons = buttons; g_net_in[pad].lx = lx; g_net_in[pad].ly = ly; g_net_in[pad].rx = rx; g_net_in[pad].ry = ry;
+    if (!(g_net_live >> pad & 1)) {
+        if (g_press_to_join && !buttons) return;
+        if (g_merge) {
+            g_net_live |= 1u << pad;
+            fprintf(stderr, "network pad %d: merged into player 1 (DM_PAD_MERGE)\n", pad + 1);
+        } else {
+            char name[16]; snprintf(name, sizeof name, "phone %d", pad + 1);
+            int slot = g_press_to_join ? pad_slot_take_lowest(&g_slots, &g_net_owner[pad], name) : pad_slot_take(&g_slots, &g_net_owner[pad], name);
+            if (slot < 0) {
+                if (!(g_net_denied >> pad & 1)) fprintf(stderr, "network pad %d: all %d players are taken\n", pad + 1, DM_PLAYERS);
+                g_net_denied |= 1u << pad;
+                return;
+            }
+            g_net_live |= 1u << pad; g_net_denied &= ~(1u << pad);
+            dm_pad_players(pad_slot_mask(&g_slots));
+            fprintf(stderr, "network pad %d: player %d\n", pad + 1, slot + 1);
+        }
+    }
+    controller_net_publish(pad);
+}
+void controllers_netpad_leave(int pad) {
+    if (pad < 0 || pad >= DM_PLAYERS) return;
+    memset(&g_net_in[pad], 0, sizeof g_net_in[pad]); g_net_denied &= ~(1u << pad);
+    if (!(g_net_live >> pad & 1)) return;
+    g_net_live &= ~(1u << pad);
+    if (g_merge) controller_publish(nil);
+    else {
+        int slot = pad_slot_free(&g_slots, &g_net_owner[pad]);
+        if (slot >= 0) { dm_pad_set_player(slot, 0, 0, 0, 0, 0); dm_pad_players(pad_slot_mask(&g_slots)); }
+    }
+    fprintf(stderr, "network pad %d: left\n", pad + 1);
+    front_cp_poll();   // one player fewer while the controller applet's prompt is up
+}
